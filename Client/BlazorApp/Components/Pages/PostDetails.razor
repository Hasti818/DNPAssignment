@page "/posts/{Id:int}"

@using System.Security.Claims
@using ApiContracts.Posts
@using ApiContracts.Comments
@using BlazorApp.Services

@inject IPostService PostService
@inject ICommentService CommentService

<PageTitle>Post Details</PageTitle>

@if (post is null)
{
    <p>Loading...</p>
}
else
{
    <h1>@post.Title</h1>

    <p>
        <strong>Author:</strong> @post.UserName
    </p>

    <p>@post.Body</p>

    <hr />

    <h3>Comments</h3>

    @if (comments.Count == 0)
    {
        <p>No comments yet.</p>
    }
    else
    {
        @foreach (CommentDto comment in comments)
        {
            <div class="card mb-2">
                <div class="card-body">
                    <strong>@comment.UserName</strong>
                    <p>@comment.Body</p>
                </div>
            </div>
        }
    }

    <hr />

    <h4>Add Comment</h4>

    @if (userId == 0)
    {
        <p>You must be logged in to add a comment.</p>
    }
    else
    {
        <textarea class="form-control mb-2"
                  @bind="commentBody">
        </textarea>

        <button class="btn btn-primary"
                @onclick="AddCommentAsync">
            Add Comment
        </button>
    }
}

@if (!string.IsNullOrWhiteSpace(message))
{
    <p class="mt-3">@message</p>
}

@code {
    [Parameter]
    public int Id { get; set; }

    [CascadingParameter]
    public Task<AuthenticationState> AuthenticationStateTask { get; set; } = null!;

    private PostDto? post;
    private List<CommentDto> comments = new();

    private int userId;

    private string commentBody = "";
    private string message = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            AuthenticationState authenticationState =
                await AuthenticationStateTask;

            ClaimsPrincipal claimsPrincipal =
                authenticationState.User;

            if (claimsPrincipal.Identity is not null &&
                claimsPrincipal.Identity.IsAuthenticated)
            {
                Claim? idClaim = claimsPrincipal.Claims
                    .SingleOrDefault(claim =>
                        claim.Type == ClaimTypes.NameIdentifier);

                if (idClaim is not null)
                {
                    userId = int.Parse(idClaim.Value);
                }
            }

            post = await PostService.GetPostAsync(Id);

            comments =
                await CommentService.GetCommentsForPostAsync(Id);
        }
        catch (Exception e)
        {
            message = e.Message;
        }
    }

    private async Task AddCommentAsync()
    {
        try
        {
            if (userId == 0)
            {
                message = "You must be logged in to add a comment.";
                return;
            }

            CreateCommentDto request = new CreateCommentDto
            {
                Body = commentBody,
                UserId = userId
            };

            CommentDto createdComment =
                await CommentService.AddCommentAsync(Id, request);

            comments.Add(createdComment);

            commentBody = "";

            message = "Comment added successfully.";
        }
        catch (Exception e)
        {
            message = e.Message;
        }
    }
}