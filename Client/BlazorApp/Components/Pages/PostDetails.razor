@page "/posts/{Id:int}"


@using ApiContracts.Posts
@using ApiContracts.Comments
@using BlazorApp.Services

@inject IPostService PostService
@inject ICommentService CommentService

<PageTitle>Post Details</PageTitle>

@if (post is null)
{
    <p>Loading...</p>
}
else
{
    <h1>@post.Title</h1>

    <p>
        <strong>Author:</strong> @post.UserName
    </p>

    <p>@post.Body</p>

    <hr />

    <h3>Comments</h3>

    @if (comments.Count == 0)
    {
        <p>No comments yet.</p>
    }
    else
    {
        @foreach (CommentDto comment in comments)
        {
            <div class="card mb-2">
                <div class="card-body">
                    <strong>@comment.UserName</strong>
                    <p>@comment.Body</p>
                </div>
            </div>
        }
    }

    <hr />

    <h4>Add Comment</h4>

    <textarea class="form-control mb-2"
              @bind="commentBody">
    </textarea>

    <button class="btn btn-primary"
            @onclick="AddCommentAsync">
        Add Comment
    </button>
}

@if (!string.IsNullOrWhiteSpace(message))
{
    <p class="mt-3">@message</p>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private PostDto? post;
    private List<CommentDto> comments = new();

    private string commentBody = "";
    private string message = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            post = await PostService.GetPostAsync(Id);

            comments =
                await CommentService.GetCommentsForPostAsync(Id);
        }
        catch (Exception e)
        {
            message = e.Message;
        }
    }

    private async Task AddCommentAsync()
    {
        try
        {
            CreateCommentDto request = new CreateCommentDto
            {
                Body = commentBody,
                UserId = 1
            };

            CommentDto createdComment =
                await CommentService.AddCommentAsync(Id, request);

            comments.Add(createdComment);

            commentBody = "";
            message = "Comment added successfully.";
        }
        catch (Exception e)
        {
            message = e.Message;
        }
    }
}