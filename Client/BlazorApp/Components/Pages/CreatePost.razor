@page "/create-post"
@attribute [Authorize]

@using System.Security.Claims
@using ApiContracts.Posts
@using BlazorApp.Services

@inject IPostService PostService

<PageTitle>Create Post</PageTitle>

<h1>Create Post</h1>

<div class="mb-3">
    <label>Title</label>
    <input class="form-control" @bind="title" />
</div>

<div class="mb-3">
    <label>Body</label>
    <textarea class="form-control" @bind="body"></textarea>
</div>

<button class="btn btn-primary" @onclick="CreatePostAsync">
    Create Post
</button>

@if (!string.IsNullOrWhiteSpace(message))
{
    <p class="mt-3">@message</p>
}

@code {
    private string title = "";
    private string body = "";
    private string message = "";

    private int userId;

    [CascadingParameter]
    public Task<AuthenticationState> AuthenticationStateTask { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState authenticationState =
            await AuthenticationStateTask;

        ClaimsPrincipal claimsPrincipal =
            authenticationState.User;

        if (claimsPrincipal.Identity is null ||
            !claimsPrincipal.Identity.IsAuthenticated)
        {
            return;
        }

        Claim? idClaim = claimsPrincipal.Claims
            .SingleOrDefault(claim =>
                claim.Type == ClaimTypes.NameIdentifier);

        if (idClaim is not null)
        {
            userId = int.Parse(idClaim.Value);
        }
    }

    private async Task CreatePostAsync()
    {
        try
        {
            if (userId == 0)
            {
                message = "You must be logged in to create a post.";
                return;
            }

            CreatePostDto request = new CreatePostDto
            {
                Title = title,
                Body = body,
                UserId = userId
            };

            PostDto createdPost =
                await PostService.AddPostAsync(request);

            message =
                $"Post '{createdPost.Title}' created successfully.";

            title = "";
            body = "";
        }
        catch (Exception e)
        {
            message = e.Message;
        }
    }
}