@page "/create-comment"
@attribute [Authorize]

@using System.Security.Claims
@using ApiContracts.Comments
@using BlazorApp.Services

@inject ICommentService CommentService

<PageTitle>Create Comment</PageTitle>

<h1>Create Comment</h1>

<div class="mb-3">
    <label>Post ID</label>
    <input class="form-control" type="number" @bind="postId" />
</div>

<div class="mb-3">
    <label>Comment</label>
    <textarea class="form-control" @bind="body"></textarea>
</div>

<button class="btn btn-primary" @onclick="CreateCommentAsync">
    Add Comment
</button>

@if (!string.IsNullOrWhiteSpace(message))
{
    <p class="mt-3">@message</p>
}

@code {
    private int postId;
    private int userId;

    private string body = "";
    private string message = "";

    [CascadingParameter]
    public Task<AuthenticationState> AuthenticationStateTask { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState authenticationState =
            await AuthenticationStateTask;

        ClaimsPrincipal claimsPrincipal =
            authenticationState.User;

        if (claimsPrincipal.Identity is null ||
            !claimsPrincipal.Identity.IsAuthenticated)
        {
            return;
        }

        Claim? idClaim = claimsPrincipal.Claims
            .SingleOrDefault(claim =>
                claim.Type == ClaimTypes.NameIdentifier);

        if (idClaim is not null)
        {
            userId = int.Parse(idClaim.Value);
        }
    }

    private async Task CreateCommentAsync()
    {
        try
        {
            if (userId == 0)
            {
                message = "You must be logged in to add a comment.";
                return;
            }

            CreateCommentDto request = new CreateCommentDto
            {
                Body = body,
                UserId = userId
            };

            CommentDto createdComment =
                await CommentService.AddCommentAsync(postId, request);

            message =
                $"Comment {createdComment.Id} added successfully.";

            body = "";
        }
        catch (Exception e)
        {
            message = e.Message;
        }
    }
}